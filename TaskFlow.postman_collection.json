      "name": "2. Auth",
      "item": [
        {
          "name": "Register a user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString(36) + Math.random().toString(36).slice(2, 8);",
                  "pm.collectionVariables.set('registeredEmail', 'smoke.' + suffix + '@example.com');",
                  "// Meets every password rule (upper, lower, digit, special) and stays far below 72 bytes.",
                  "pm.collectionVariables.set('generatedPassword', 'Sm0ke!' + suffix + 'Aa');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('confirms the account was created', function () {",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.message).to.include('created');",
                  "});",
                  "pm.test('does not echo the password', function () {",
                  "  pm.expect(pm.response.text()).to.not.include(pm.collectionVariables.get('generatedPassword'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Generates a unique throwaway account (smoke.<id>@example.com) for every run.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Smoke Test\",\n  \"email\": \"{{registeredEmail}}\",\n  \"password\": \"{{generatedPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Register the same email again",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', function () { pm.response.to.have.status(409); });",
                  "const body = pm.response.json();",
                  "pm.test('uses the standard error shape with code EMAIL_ALREADY_REGISTERED', function () {",
                  "  pm.expect(body.success).to.eql(false);",
                  "  pm.expect(body.error.code).to.eql('EMAIL_ALREADY_REGISTERED');",
                  "  pm.expect(body.error.message).to.be.a('string').and.not.empty;",
