              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('reports ok', function () { pm.expect(pm.response.json()).to.eql({ status: 'ok' }); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/live",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "live"
              ]
            }
          }
        },
        {
          "name": "Readiness",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('reports ok (database connected)', function () { pm.expect(pm.response.json()).to.eql({ status: 'ok' }); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "ready"
              ]
            }
          }
        },
        {
          "name": "API entry point",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('links to the docs and health endpoints', function () {",
                  "  pm.expect(body.docs).to.eql('/api-docs');",
                  "  pm.expect(body.openapi).to.eql('/api-docs.json');",
                  "  pm.expect(body.health).to.eql({ live: '/health/live', ready: '/health/ready' });",
                  "});",
                  "pm.test('reports a version', function () { pm.expect(body.version).to.be.a('string').and.not.empty; });",
                  "const expectedCommit = pm.variables.get('expectedCommit');",
                  "if (expectedCommit) {",
                  "  pm.test('deployed commit matches the expected release commit', function () {",
                  "    pm.expect(body.commit).to.eql(expectedCommit);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            },
            "description": "Optional: run with --env-var expectedCommit=<sha> to assert the deployed commit."
          }
        },
        {
          "name": "OpenAPI document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const spec = pm.response.json();",
                  "const expectedPaths = ['/', '/health/live', '/health/ready', '/api/auth/register', '/api/auth/login', '/api/tasks', '/api/tasks/{id}'];",
                  "pm.test('is a non-empty OpenAPI document', function () {",
                  "  pm.expect(spec.openapi).to.be.a('string');",
                  "  pm.expect(Object.keys(spec.paths)).to.not.be.empty;",
                  "});",
                  "pm.test('documents every route', function () {",
                  "  pm.expect(Object.keys(spec.paths)).to.have.members(expectedPaths);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api-docs.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api-docs.json"
              ]
            }
          }
        }
      ]
    },
