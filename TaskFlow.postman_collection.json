{
  "info": {
    "name": "TaskFlow Collection",
    "description": "Smoke test for the TaskFlow API: health, register, login, create, list, get, update, delete, plus error paths and request-ID checks.\n\nRun locally:    npm run smoke\nRun deployed:   npm run smoke -- --env-var baseUrl=https://<host>\nAssert commit:  add --env-var expectedCommit=<sha>\n\nEach run registers a throwaway user (smoke.<id>@example.com). Do not add a rate-limit test to this collection: it would lock the runner out of the auth routes for 15 minutes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('response carries an X-Request-Id header', function () {",
          "  pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string').and.not.empty;",
          "});",
          "pm.test('response does not leak stack traces or internals', function () {",
          "  const text = pm.response.text();",
          "  pm.expect(text).to.not.include('node_modules');",
          "  pm.expect(text).to.not.match(/\"stack\"\\s*:/);",
          "  pm.expect(text).to.not.match(/\\sat\\s[^\\n]*\\(.*:\\d+:\\d+\\)/);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "expectedCommit",
      "value": ""
    },
    {
      "key": "token",
      "value": "",
      "type": "secret"
    },
    {
      "key": "generatedPassword",
      "value": "",
      "type": "secret"
    },
    {
      "key": "registeredEmail",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "taskTitle",
      "value": ""
    },
    {
      "key": "traceId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Health & meta",
      "item": [
        {
          "name": "Liveness",
          "event": [
