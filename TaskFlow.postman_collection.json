              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const responseBody = pm.response.json();\r\npm.collectionVariables.set('token', responseBody.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
