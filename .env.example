PORT=5000
JWT_SECRET="randomly_generated_secret_key"

# Atlas offers two connection-string formats. The mongodb+srv:// string works on most networks.
# If its DNS SRV lookup fails on your machine, use the standard mongodb:// string with explicit hosts, as below.
MONGODB_URI="mongodb://<username>:<password>@shard-00-00.xxxxx.mongodb.net:27017,shard-00-01.xxxxx.mongodb.net:27017,shard-00-02.xxxxx.mongodb.net:27017/?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin&appName=taskFlow"